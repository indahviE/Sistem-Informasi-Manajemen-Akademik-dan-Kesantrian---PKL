generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USTADZ
  MUSYRIF
  WALI_SANTRI
  SANTRI
  PIMPINAN
}

enum TenantStatus {
  PENDING
  AKTIF
  SUSPENDED
}

enum StatusGelombangPpdb {
  DIBUKA
  DITUTUP
}

enum UserStatus {
  AKTIF
  NONAKTIF
}

enum SantriStatus {
  AKTIF
  LULUS
  KELUAR
}

enum JenisUstadz {
  GURU
  MUSYRIF
}

enum AbsensiStatus {
  HADIR
  IZIN
  SAKIT
  ALPA
}

enum JenisNilai {
  HARIAN
  ULANGAN
  TAHFIDZ
  BAHASA_ARAB
}

enum JenisPerizinan {
  PULANG
  KELUAR
}

enum StatusApproval {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  KEMBALI
  TELAT
}

enum StatusKesehatan {
  RAWAT_JALAN
  DIRUJUK
  SEMBUH
}

enum JenisNotifikasi {
  PELANGGARAN
  KESEHATAN
  PERIZINAN
  NILAI
  ABSENSI
  SISTEM
}

model Tenant {
  id                  String              @id @default(cuid())
  kodeTenant          String              @unique
  namaPondok          String
  logoUrl             String?             @db.MediumText
  warnaTema           String?
  status              TenantStatus        @default(PENDING)
  kuotaSantriPpdb     Int?
  statusGelombangPpdb StatusGelombangPpdb @default(DITUTUP)
  adminAwalId         String?
  tanggalDaftar       DateTime            @default(now())

  users         User[]
  santris       Santri[]
  ustadzs       Ustadz[]
  kelas         Kelas[]
  waliSantris   WaliSantri[]
  mapels        MataPelajaran[]
  tataTertib    TataTertib[]
  tahunAjaran   TahunAjaran[]
  pendaftarans  Pendaftaran[]
  kurikulums    Kurikulum[]
  silabus       Silabus[]
  rpps          Rpp[]
  rekamMedis    RekamMedis[]
  subscriptions Subscription[]
  invoices      Invoice[]
  ujians        Ujian[]
  nilaiUjians   NilaiUjian[]
  remedials     Remedial[]
  rapors        Rapor[]
  kelulusans    Kelulusan[]
  konselings    Konseling[]

  @@map("tenants")
}

model User {
  id           String     @id @default(cuid())
  tenantId     String?
  nama         String
  email        String
  passwordHash String
  role         Role
  status       UserStatus @default(AKTIF)
  createdAt    DateTime   @default(now())

  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  notifikasis Notifikasi[]
  waliSantris WaliSantri[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Santri {
  id           String       @id @default(cuid())
  tenantId     String
  nis          String
  nama         String
  jenisKelamin String
  tanggalLahir DateTime?
  kelasId      String?
  asrama       String?
  waliId       String?
  status       SantriStatus @default(AKTIF)
  tahunMasuk   Int

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  kelas           Kelas?           @relation(fields: [kelasId], references: [id])
  wali            WaliSantri?      @relation(fields: [waliId], references: [id])
  absensis        Absensi[]
  nilais          Nilai[]
  capaianTahfidzs CapaianTahfidz[]
  pelanggarans    Pelanggaran[]
  perizinan       Perizinan[]
  kesehatanLogs   KesehatanLog[]
  kunjunganWali   KunjunganWali[]
  rekamMedis      RekamMedis?
  nilaiUjians     NilaiUjian[]
  remedials       Remedial[]
  rapors          Rapor[]
  kelulusans      Kelulusan[]
  konselings      Konseling[]

  @@unique([tenantId, nis])
  @@index([tenantId, kelasId])
  @@index([tenantId])
  @@map("santris")
}

model Ustadz {
  id       String      @id @default(cuid())
  tenantId String
  nama     String
  jenis    JenisUstadz @default(GURU)
  noHp     String?
  userId   String?

  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  kelasDiampu       Kelas[]
  konselingKonselor Konseling[]

  @@index([tenantId])
  @@map("ustadzs")
}

model Kelas {
  id            String  @id @default(cuid())
  tenantId      String
  namaKelas     String
  tingkat       String
  waliKelasId   String?
  tahunAjaranId String?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  waliKelas   Ustadz?      @relation(fields: [waliKelasId], references: [id])
  tahunAjaran TahunAjaran? @relation(fields: [tahunAjaranId], references: [id])
  santris     Santri[]
  ujians      Ujian[]

  @@unique([tenantId, namaKelas, tahunAjaranId])
  @@index([tenantId])
  @@map("kelas")
}

model WaliSantri {
  id       String  @id @default(cuid())
  tenantId String
  nama     String
  noHp     String?
  email    String?
  hubungan String
  userId   String?

  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  santris          Santri[]
  user             User?           @relation(fields: [userId], references: [id])
  kunjunganWalinya KunjunganWali[]

  @@index([tenantId])
  @@map("wali_santris")
}

model MataPelajaran {
  id        String  @id @default(cuid())
  tenantId  String
  namaMapel String
  kode      String?
  jenis     String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  absensis       Absensi[]
  nilais         Nilai[]
  silabus        Silabus[]
  rpps           Rpp[]
  placementTests PlacementTest[]
  ujians         Ujian[]
  remedials      Remedial[]

  @@unique([tenantId, namaMapel])
  @@index([tenantId])
  @@map("mata_pelajarans")
}

model TahunAjaran {
  id       String  @id @default(cuid())
  tenantId String
  nama     String
  aktif    Boolean @default(true)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  kelas      Kelas[]
  kurikulums Kurikulum[]

  @@unique([tenantId, nama])
  @@map("tahun_ajarans")
}

model Absensi {
  id        String        @id @default(cuid())
  tenantId  String
  santriId  String
  kelasId   String?
  mapelId   String?
  tanggal   DateTime
  status    AbsensiStatus
  catatan   String?
  inputOleh String
  createdAt DateTime      @default(now())

  santri Santri         @relation(fields: [santriId], references: [id], onDelete: Cascade)
  mapel  MataPelajaran? @relation(fields: [mapelId], references: [id])

  @@index([tenantId, santriId, tanggal])
  @@index([tenantId, tanggal])
  @@index([tenantId])
  @@map("absensis")
}

model Nilai {
  id         String     @id @default(cuid())
  tenantId   String
  santriId   String
  mapelId    String
  jenis      JenisNilai
  nilai      Float
  keterangan String?
  tanggal    DateTime
  inputOleh  String
  createdAt  DateTime   @default(now())

  santri Santri        @relation(fields: [santriId], references: [id], onDelete: Cascade)
  mapel  MataPelajaran @relation(fields: [mapelId], references: [id])

  @@index([tenantId, santriId, mapelId])
  @@index([tenantId])
  @@map("nilais")
}

model CapaianTahfidz {
  id            String   @id @default(cuid())
  tenantId      String
  santriId      String
  juz           Int
  halaman       Int
  tanggalSetor  DateTime
  catatanUstadz String?
  inputOleh     String
  createdAt     DateTime @default(now())

  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@index([tenantId, santriId])
  @@map("capaian_tahfidzs")
}

model Pelanggaran {
  id               String   @id @default(cuid())
  tenantId         String
  santriId         String
  jenisPelanggaran String
  poin             Int
  tanggal          DateTime
  pelaporId        String?
  tindakLanjut     String?
  status           String   @default("DICATAT")
  createdAt        DateTime @default(now())

  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@index([tenantId, santriId])
  @@index([tenantId, tanggal])
  @@map("pelanggarans")
}

model Perizinan {
  id             String         @id @default(cuid())
  tenantId       String
  santriId       String
  jenis          JenisPerizinan
  tanggalKeluar  DateTime
  tanggalKembali DateTime?
  alasan         String
  statusApproval StatusApproval @default(DIAJUKAN)
  disetujuiOleh  String?
  catatan        String?
  createdAt      DateTime       @default(now())

  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@index([tenantId, santriId])
  @@index([tenantId])
  @@map("perizinan")
}

model KesehatanLog {
  id        String          @id @default(cuid())
  tenantId  String
  santriId  String
  keluhan   String
  diagnosa  String?
  tindakan  String?
  obat      String?
  tempat    String          @default("UKS")
  tanggal   DateTime
  status    StatusKesehatan @default(RAWAT_JALAN)
  inputOleh String
  createdAt DateTime        @default(now())

  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@index([tenantId, santriId])
  @@index([tenantId])
  @@map("kesehatan_logs")
}

model KunjunganWali {
  id        String   @id @default(cuid())
  tenantId  String
  santriId  String
  waliId    String?
  tanggal   DateTime
  catatan   String?
  createdAt DateTime @default(now())

  santri Santri      @relation(fields: [santriId], references: [id], onDelete: Cascade)
  wali   WaliSantri? @relation(fields: [waliId], references: [id])

  @@index([tenantId, santriId])
  @@map("kunjungan_walis")
}

model Notifikasi {
  id         String          @id @default(cuid())
  tenantId   String
  userId     String?
  jenis      JenisNotifikasi
  pesan      String
  statusBaca Boolean         @default(false)
  tanggal    DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, statusBaca])
  @@map("notifikasis")
}

model TataTertib {
  id        String   @id @default(cuid())
  tenantId  String
  judul     String
  isi       String
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("tata_tertibs")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  userNama  String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, entity, createdAt])
  @@map("audit_logs")
}

enum StatusPendaftaran {
  DIAJUKAN
  TES
  DITERIMA
  DITOLAK
  WAITING_LIST
}

enum StatusSubscription {
  AKTIF
  EXPIRED
  CANCELED
}

enum StatusInvoice {
  BELUM_BAYAR
  LUNAS
  BATAL
}

model Pendaftaran {
  id            String            @id @default(cuid())
  tenantId      String
  nama          String
  jenisKelamin  String
  tanggalLahir  DateTime?
  asalSekolah   String?
  noHp          String?
  email         String?
  alamat        String?
  jalur         String?
  status        StatusPendaftaran @default(DIAJUKAN)
  catatan       String?
  tanggalDaftar DateTime          @default(now())
  ujian         PlacementTest?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId])
  @@map("pendaftarans")
}

model PlacementTest {
  id            String   @id @default(cuid())
  tenantId      String
  pendaftaranId String   @unique
  mapelId       String?
  nilai         Float?
  hasil         String?
  catatan       String?
  tanggal       DateTime @default(now())

  pendaftaran Pendaftaran    @relation(fields: [pendaftaranId], references: [id])
  mapel       MataPelajaran? @relation(fields: [mapelId], references: [id])

  @@index([tenantId])
  @@map("placement_tests")
}

model Kurikulum {
  id            String   @id @default(cuid())
  tenantId      String
  nama          String
  tahunAjaranId String?
  deskripsi     String?
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  tahunAjaran TahunAjaran? @relation(fields: [tahunAjaranId], references: [id])
  silabus     Silabus[]

  @@index([tenantId])
  @@map("kurikulums")
}

model Silabus {
  id              String   @id @default(cuid())
  tenantId        String
  kurikulumId     String?
  mapelId         String?
  judul           String
  kompetensiDasar String?
  materiPokok     String?
  alokasiWaktu    String?
  fileUrl         String?
  createdAt       DateTime @default(now())

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  kurikulum Kurikulum?     @relation(fields: [kurikulumId], references: [id])
  mapel     MataPelajaran? @relation(fields: [mapelId], references: [id])

  @@index([tenantId])
  @@map("silabus")
}

model Rpp {
  id        String   @id @default(cuid())
  tenantId  String
  mapelId   String?
  pertemuan Int
  judul     String
  tujuan    String?
  kegiatan  String?
  penilaian String?
  fileUrl   String?
  createdAt DateTime @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  mapel  MataPelajaran? @relation(fields: [mapelId], references: [id])

  @@index([tenantId])
  @@map("rpps")
}

model RekamMedis {
  id              String   @id @default(cuid())
  tenantId        String
  santriId        String   @unique
  golonganDarah   String?
  alergi          String?
  riwayatPenyakit String?
  tinggiBadan     Int?
  beratBadan      Int?
  catatanKhusus   String?
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("rekam_medis")
}

model Paket {
  id          String   @id @default(cuid())
  nama        String
  harga       Float
  limitSantri Int
  fitur       Json?
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())

  subscriptions Subscription[]

  @@map("pakets")
}

model Subscription {
  id           String             @id @default(cuid())
  tenantId     String
  paketId      String
  tanggalMulai DateTime           @default(now())
  tanggalAkhir DateTime?
  status       StatusSubscription @default(AKTIF)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  paket  Paket  @relation(fields: [paketId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

model Invoice {
  id                String        @id @default(cuid())
  tenantId          String
  noInvoice         String
  jumlah            Float
  status            StatusInvoice @default(BELUM_BAYAR)
  tanggalJatuhTempo DateTime?
  tanggalBayar      DateTime?
  metodeBayar       String?
  createdAt         DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, noInvoice])
  @@index([tenantId])
  @@map("invoices")
}

model Ujian {
  id          String    @id @default(cuid())
  tenantId    String
  nama        String
  jenis       String    @default("ULANGAN")
  mapelId     String?
  kelasId     String?
  tanggal     DateTime?
  durasiMenit Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  mapel     MataPelajaran? @relation(fields: [mapelId], references: [id])
  kelas     Kelas?         @relation(fields: [kelasId], references: [id])
  nilais    NilaiUjian[]
  remedials Remedial[]

  @@index([tenantId])
  @@map("ujians")
}

model NilaiUjian {
  id        String   @id @default(cuid())
  tenantId  String
  ujianId   String
  santriId  String
  nilai     Float
  catatan   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  ujian  Ujian  @relation(fields: [ujianId], references: [id])
  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@unique([ujianId, santriId])
  @@index([tenantId])
  @@map("nilai_ujians")
}

model Remedial {
  id         String   @id @default(cuid())
  tenantId   String
  santriId   String
  ujianId    String?
  mapelId    String?
  keterangan String
  hasil      String?  @default("PROSES")
  tanggal    DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  santri Santri         @relation(fields: [santriId], references: [id], onDelete: Cascade)
  ujian  Ujian?         @relation(fields: [ujianId], references: [id])
  mapel  MataPelajaran? @relation(fields: [mapelId], references: [id])

  @@index([tenantId])
  @@map("remedials")
}

enum StatusRapor {
  DRAFT
  TERBIT
}

model Rapor {
  id        String      @id @default(cuid())
  tenantId  String
  santriId  String
  periode   String
  ringkasan Json?
  rataRata  Float?
  status    StatusRapor @default(DRAFT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@unique([tenantId, santriId, periode])
  @@index([tenantId])
  @@map("rapors")
}

enum PredikatKelulusan {
  MEMUASKAN
  HONOUR
  CUM_LAUDE
  SUMMA_CUM_LAUDE
}

model Kelulusan {
  id               String             @id @default(cuid())
  tenantId         String
  santriId         String
  status           String             @default("LULUS")
  tanggalKelulusan DateTime           @default(now())
  predikat         PredikatKelulusan?
  juzYangDiHafal   Int?
  catatan          String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@unique([tenantId, santriId])
  @@index([tenantId])
  @@map("kelulusans")
}

model Konseling {
  id           String   @id @default(cuid())
  tenantId     String
  santriId     String
  tanggal      DateTime @default(now())
  konselorId   String?
  topik        String
  catatan      String
  tindakLanjut String?
  privat       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  santri   Santri  @relation(fields: [santriId], references: [id], onDelete: Cascade)
  konselor Ustadz? @relation(fields: [konselorId], references: [id])

  @@index([tenantId])
  @@map("konselings")
}

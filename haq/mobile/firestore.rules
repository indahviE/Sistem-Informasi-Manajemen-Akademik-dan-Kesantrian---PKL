rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- helper ----------
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function inTenant(tid) { return signedIn() && me().tenantId == tid; }
    function hasRole(tid, roles) { return inTenant(tid) && me().role in roles; }
    function isAdmin(tid) { return hasRole(tid, ['ADMIN']); }
    function isStaff(tid) { return hasRole(tid, ['ADMIN', 'PIMPINAN', 'USTADZ', 'MUSYRIF']); }

    // ---------- users ----------
    // Dokumen akun: tenantId, role, ustadzId, kelasIds, santriIds (untuk wali)
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid
                      || (me().role == 'ADMIN' && me().tenantId == resource.data.tenantId));
      // Admin boleh ubah akun di pondoknya sendiri (mis. sinkron kelasIds).
      allow update: if signedIn() && me().role == 'ADMIN'
                      && me().tenantId == resource.data.tenantId
                      && request.resource.data.tenantId == resource.data.tenantId
                      && request.resource.data.role == resource.data.role;
      allow create, delete: if false; // pembuatan akun lewat Cloud Function / Admin SDK
    }

    // ---------- tenants ----------
    match /tenants/{tid} {
      allow read: if inTenant(tid);

      match /santri/{nis} {
        allow read: if isStaff(tid)
                    || (hasRole(tid, ['WALI_SANTRI']) && nis in me().santriIds);
        allow create, update: if isAdmin(tid);
        allow delete: if false; // santri tidak dihapus, status = KELUAR
      }

      match /kelas/{id} {
        allow read: if isStaff(tid);
        allow write: if isAdmin(tid);
      }

      match /mapel/{id} {
        allow read: if hasRole(tid, ['ADMIN', 'PIMPINAN', 'USTADZ', 'MUSYRIF']);
        allow write: if isAdmin(tid);
      }

      match /tahunAjaran/{id} {
        allow read: if isStaff(tid);
        allow write: if isAdmin(tid);
      }

      match /ustadz/{id} {
        allow read: if hasRole(tid, ['ADMIN', 'PIMPINAN'])
                    || (hasRole(tid, ['USTADZ', 'MUSYRIF']) && me().ustadzId == id);
        allow write: if isAdmin(tid);
      }

      // ID dokumen: {ustadzId}_{kelasId}_{mapelId} (menggantikan unique + upsert)
      match /mengajar/{id} {
        allow read: if hasRole(tid, ['ADMIN', 'PIMPINAN'])
                    || (hasRole(tid, ['USTADZ']) && resource.data.ustadzId == me().ustadzId);
        allow write: if isAdmin(tid);
      }

      match /wali/{id} {
        allow read: if isStaff(tid)
                    || (hasRole(tid, ['WALI_SANTRI']) && resource.data.userId == request.auth.uid);
        allow write: if isAdmin(tid);
      }

      match /counters/{id} {
        allow read, write: if isAdmin(tid);
      }

      // ===== A: USTADZ/MUDIR =====
      // ID dokumen: {tanggal}_{mapelId}_{santriId}
      match /absensi/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || hasRole(tid, ['MUSYRIF'])
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.kelasId in me().kelasIds);
        allow update: if isAdmin(tid); // sudah direkap = terkunci, hanya admin
        allow delete: if false;
      }

      // ===== NILAI =====
      // ID dokumen: {santriId}_{mapelId}_{jenis}_{skill}_{tanggal}
      match /nilai/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.kelasId in me().kelasIds);
        allow update: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && resource.data.kelasId in me().kelasIds
                          && request.resource.data.kelasId == resource.data.kelasId);
        allow delete: if false;
      }

      // ===== TAHFIDZ =====
      // ID dokumen: acak (satu santri boleh setor lebih dari sekali per hari)
      match /tahfidz/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || hasRole(tid, ['MUSYRIF'])
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.kelasId in me().kelasIds);
        allow update, delete: if false; // setoran tidak diubah/dihapus dari aplikasi
      }

            // ===== UJIAN & REMEDIAL =====
      // ujian: auto-ID. nilaiUjian & remedial: ID = {ujianId}_{santriId}
      match /ujian/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.dibuatOleh == request.auth.uid);
        allow update, delete: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && (resource.data.dibuatOleh == request.auth.uid
                              || resource.data.kelasId in me().kelasIds));
      }

      match /nilaiUjian/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.kelasId in me().kelasIds);
        allow update: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && resource.data.kelasId in me().kelasIds
                          && request.resource.data.kelasId == resource.data.kelasId);
        allow delete: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && resource.data.kelasId in me().kelasIds);
      }

      match /remedial/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.kelasId in me().kelasIds);
        allow update: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && resource.data.kelasId in me().kelasIds
                          && request.resource.data.kelasId == resource.data.kelasId);
        allow delete: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && resource.data.kelasId in me().kelasIds);
      }

      // ===== KELULUSAN =====
      // ID dokumen = santriId
      match /kelulusan/{id} {
        allow read: if hasRole(tid, ['ADMIN', 'PIMPINAN', 'USTADZ'])
                    || (hasRole(tid, ['WALI_SANTRI']) && id in me().santriIds);
        allow create, update: if hasRole(tid, ['ADMIN', 'USTADZ']);
        allow delete: if isAdmin(tid);
      }

      // ===== RAPOR =====
      // ID dokumen: {santriId}_{periode}
      match /rapor/{id} {
        allow read: if hasRole(tid, ['ADMIN', 'PIMPINAN', 'USTADZ'])
                    || (hasRole(tid, ['WALI_SANTRI'])
                        && resource.data.status == 'TERBIT'
                        && resource.data.santriId in me().santriIds);
        allow create: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.kelasId in me().kelasIds);
        allow update, delete: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && resource.data.kelasId in me().kelasIds);
      }

      // Jejak audit (kunci, buka kunci, ubah/hapus nilai): tidak bisa diubah dari aplikasi
      match /auditLog/{id} {
        allow read: if hasRole(tid, ['ADMIN', 'PIMPINAN']);
        allow create: if hasRole(tid, ['ADMIN', 'USTADZ']);
        allow update, delete: if false;
      }

            match /notifikasi/{nid} {
        allow read: if inTenant(tid) && resource.data.userId == request.auth.uid;
        allow update: if inTenant(tid)
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusBaca']);
        allow create: if inTenant(tid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.statusBaca == false
          && request.resource.data.jenis in ['ABSENSI', 'NILAI'];
        allow delete: if false;
      }
    }
  }
}

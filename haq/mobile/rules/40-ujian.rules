      // ===== UJIAN & REMEDIAL =====
      // ujian: auto-ID. nilaiUjian & remedial: ID = {ujianId}_{santriId}
      match /ujian/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.dibuatOleh == request.auth.uid);
        allow update, delete: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && (resource.data.dibuatOleh == request.auth.uid
                              || resource.data.kelasId in me().kelasIds));
      }

      match /nilaiUjian/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.kelasId in me().kelasIds);
        allow update: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && resource.data.kelasId in me().kelasIds
                          && request.resource.data.kelasId == resource.data.kelasId);
        allow delete: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && resource.data.kelasId in me().kelasIds);
      }

      match /remedial/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.kelasId in me().kelasIds);
        allow update: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && resource.data.kelasId in me().kelasIds
                          && request.resource.data.kelasId == resource.data.kelasId);
        allow delete: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && resource.data.kelasId in me().kelasIds);
      }
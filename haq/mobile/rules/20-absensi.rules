      // ===== A: USTADZ/MUDIR =====
      // ID dokumen: {tanggal}_{mapelId}_{santriId}
      match /absensi/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || hasRole(tid, ['MUSYRIF'])
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.kelasId in me().kelasIds);
        allow update: if isAdmin(tid); // sudah direkap = terkunci, hanya admin
        allow delete: if false;
      }
      // ===== NILAI =====
      // ID dokumen: {santriId}_{mapelId}_{jenis}_{skill}_{tanggal}
      match /nilai/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.kelasId in me().kelasIds);
        allow update: if isAdmin(tid)
                      || (hasRole(tid, ['USTADZ'])
                          && resource.data.kelasId in me().kelasIds
                          && request.resource.data.kelasId == resource.data.kelasId);
        allow delete: if false;
      }

      // ===== TAHFIDZ =====
      // ID dokumen: acak (satu santri boleh setor lebih dari sekali per hari)
      match /tahfidz/{id} {
        allow read: if isStaff(tid);
        allow create: if isAdmin(tid)
                      || hasRole(tid, ['MUSYRIF'])
                      || (hasRole(tid, ['USTADZ'])
                          && request.resource.data.kelasId in me().kelasIds);
        allow update, delete: if false;
      }